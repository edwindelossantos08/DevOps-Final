{
  "name": "devops-final-taskflow",
  "version": "1.0.0",
  "description": "TaskFlow - Aplicacion web con pipeline DevOps completo (CI/CD, Docker, pruebas y monitoreo)",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand",
    "test:unit": "jest tests/unit --runInBand",
    "test:integration": "jest tests/integration --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check \"**/*.{js,json,md,yml,yaml}\"",
    "format": "prettier --write \"**/*.{js,json,md,yml,yaml}\"",
    "audit:security": "npm audit --audit-level=high",
    "docker:build": "docker build -t taskflow:local .",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down -v"
  },
  "keywords": [
    "devops",
    "ci-cd",
    "docker",
    "express",
    "sqlite",
    "prometheus"
  ],
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "prom-client": "^15.1.3",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^16.2.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "supertest": "^7.1.1"
  }
}
