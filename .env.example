# Copia este archivo a .env y ajusta los valores segun tu entorno.
# El archivo .env nunca debe subirse al repositorio (esta en .gitignore).

# Entorno de ejecucion: development | test | production
NODE_ENV=development

# Puerto HTTP donde escucha la API
PORT=3000

# Ruta del archivo SQLite. En Docker se monta un volumen sobre /app/data
DB_PATH=./data/taskflow.db

# Nivel de log: error | warn | info | http | debug
LOG_LEVEL=info

# Directorio donde se escriben los logs en JSON (leidos por Promtail)
LOG_DIR=./logs

# Rate limiting de la API: ventana en milisegundos y maximo de peticiones
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Identificador de la instancia, util cuando se ejecutan varias replicas
INSTANCE_ID=local
